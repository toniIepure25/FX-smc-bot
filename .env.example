# ── Forward Paper Trading Service Configuration ──

# Feed mode: "live" (Yahoo Finance, paper only) or "replay" (local historical data).
# The default compose service does not use OANDA directly.
FEED_MODE=live

# Data directories (inside the container)
DATA_DIR=/data/real
WATCH_DIR=/data/live
OUTPUT_DIR=/app/forward_runs

# Auto-resume from latest checkpoint on restart
AUTO_RESUME=true

# ── Optional legacy OANDA credentials ──
# Only needed if you instantiate the OANDA broker/feed modules directly.
# They are not required by the default Yahoo-backed forward service.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true

# ── Telegram Alerts (optional but highly recommended) ──
# 1. Message @BotFather on Telegram, send /newbot, follow prompts
# 2. Copy the bot token below
# 3. Message your new bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Copy the chat.id number below
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
